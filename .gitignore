# Local thesis workspace, including generated renders, images, and scripts.
/.thesis-work/

# Environment files: keep explicitly named templates and examples trackable.
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template
!**/.env.schema

# Private keys, credentials, and machine-specific secret configuration.
*.pem
*.key
*.p12
*.pfx
*.pk8
*.ppk
*.jks
*.keystore
**/id_rsa
**/id_ed25519
**/id_ecdsa
**/.ssh/
**/.aws/credentials
**/.docker/config.json
**/.git-credentials
**/.netrc
**/.pypirc
**/.npmrc
!**/.npmrc.example
**/credentials.json
**/*-credentials.json
**/*_credentials.json
**/service-account*.json
**/token.json
**/local.settings.json
!**/local.settings.example.json
**/secrets/
**/.secrets/
config.local.*

# Dependencies and generated language/tool caches.
**/.venv/
**/venv/
**/node_modules/
**/bower_components/
**/__pycache__/
*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.tox/
**/.nox/
**/.hypothesis/
**/.cache/
**/.turbo/
**/.next/
**/.nuxt/
**/.vite/
**/.parcel-cache/
**/.svelte-kit/
**/playwright-report/
**/test-results/

# Build outputs and generated packages.
**/target/
**/dist/
**/build/
**/htmlcov/
**/coverage/
*.coverage
*.coverage.*
coverage.xml
lcov.info
*.egg
*.egg-info/
*.whl
*.msi
*.deb
*.rpm
*.AppImage
*.dmg
*.exe
*.app/
*.tar
*.tar.gz
*.zip

# Runtime state, logs, temporary files, and operational backups.
**/runtime-data/
**/production-data/
**/data/runtime/
**/db-data/
**/postgres-data/
**/.backup/
**/backups/
**/dumps/
**/logs/
*.dump
*.sql.gz
*.log
*.pid
*.pid.lock

# Operating system and editor state.
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
**/.idea/
**/.vscode/
*.code-workspace
*.swp
*.swo
*~
*.tmp
